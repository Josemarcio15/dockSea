{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "$lib/*": [
        "src/lib/*"
      ],
      "$shared/*": [
        "src/lib/shared/*"
      ],
      "$navigation/*": [
        "src/lib/shared/navigation/*"
      ],
      "$session/*": [
        "src/lib/shared/session/*"
      ],
      "$bindings/*": [
        "bindings/go-walis/internal/*"
      ]
    },
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "bindings",
    "vite.config.ts"
  ]
}